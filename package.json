{
  "name": "cms-admin-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome + Firefox extension that adds tools to the CMS v1.5 admin page.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:watch": "vitest",
    "build:e2e": "wxt build --mode e2e",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare",
    "fixtures": "tsx scripts/save-fixtures.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "latency": "tsx scripts/aws-latency.ts",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "preact": "^10.29.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
